# Database (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Select exactly one WhatsApp transport. Production defaults to Meta unless
# 360dialog is explicitly enabled for the approved Preview deployment.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (server-side only)
META_APP_SECRET=
META_GRAPH_API_VERSION=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# 360dialog Direct API + Coexistence (server-side only)
D360_API_KEY=
D360_API_BASE_URL=https://waba-v2.360dialog.io
D360_WEBHOOK_USERNAME=hera-receptionist
D360_WEBHOOK_PASSWORD=
# A manual message sent from the WhatsApp Business App pauses AI replies for
# this many minutes. The default is two hours; allowed range is 5 to 1440.
D360_HUMAN_TAKEOVER_MINUTES=120

# Keep shadow until staging evaluation and explicit launch approval.
WHATSAPP_SEND_MODE=shadow
# A live deployment also requires this exact second interlock. Leave blank in shadow.
WHATSAPP_LIVE_CONFIRMATION=
HERA_MANAGEMENT_WHATSAPP_ID=

# Vercel AI Gateway. On Vercel, OIDC can be used instead of a long-lived key.
AI_GATEWAY_API_KEY=
HERA_AI_PRIMARY_MODEL=openai/gpt-5.6-sol
HERA_AI_FALLBACK_MODELS=anthropic/claude-opus-5,openai/gpt-5.6-terra
HERA_AI_VERIFIER_MODEL=anthropic/claude-opus-5
HERA_AI_TRANSCRIPTION_MODEL=openai/gpt-4o-transcribe

# Official website knowledge ingestion. Changed pages revert to draft unless
# explicitly enabled after the source-governance evaluation passes.
HERA_WEBSITE_SITEMAP_URL=https://www.herabeauty.sg/sitemap.xml
AUTO_APPROVE_HERA_WEBSITE_KNOWLEDGE=false

# Protects the recovery worker endpoint.
CRON_SECRET=
