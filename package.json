{
  "name": "hera-concierge",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:command-centre": "tsc -p tsconfig.command-centre.json",
    "build": "npm install --package-lock-only --ignore-scripts && tsx scripts/print-openai-lock.ts && npm run build:command-centre && tsx scripts/reset-gateway-build-diagnostic.ts",
    "proof:pr71": "tsx scripts/pr71-build-proof.ts",
    "proof:pr73": "tsx scripts/pr73-build-proof.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test": "npm run typecheck && npm run build && npm run test:unit",
    "credential:scan": "node scripts/scan-secrets.mjs",
    "eval:model": "tsx scripts/run-model-evals.ts",
    "certify:stage3r": "tsx src/certification/stage3r/run.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.59",
    "@ai-sdk/openai": "4.0.52",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/functions": "3.9.5",
    "ai": "7.0.73",
    "cheerio": "1.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vercel/node": "5.10.2",
    "libpg-query": "17.7.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
