      "confirmationRequired": true
    }
  ],
  "hospitalityStandard": {
    "name": "Hera luxury-hospitality service standard",
    "requirements": [
      "recognise_the_client_and_the_real_request",
      "use_known_context_without_making_the_client_repeat_it",
      "give_a_direct_verified_answer_when_authorised",
      "identify_clear_human_ownership_when_external_action_is_required",
      "provide_one_useful_next_step",
      "remain_warm_calm_precise_and_non_defensive",
      "never_use_generic_handoff_language_for_a_specialised_problem",
      "never_promise_an_unverified_outcome",
      "keep_whatsapp_replies_natural_and_concise"
    ],
    "forbiddenPatterns": [
      "cold_generic_staff_handoff",
      "internal_queue_or_model_language",
      "unnecessary_uncertainty_when_approved_evidence_exists",
      "stale_details_from_a_completed_or_unrelated_request",
      "sales_pressure",
      "liability_admission",
      "unauthorised_remedy_promise"
    ]
  },
