  ],
  "confirmedPolicies": [
    {
      "id": "published_prices_before_gst",
      "rule": "Published service prices are before 9% GST unless the approved source explicitly states otherwise.",
      "aiAuthority": "explain_only",
      "source": "docs/SOURCE_OF_TRUTH.md#confirmed-operational-rules"
    },
    {
      "id": "colour_consultation_quote_consent",
      "rule": "Colour services require consultation, a clear quotation and client consent before work begins.",
      "aiAuthority": "explain_and_collect_information",
      "source": "docs/SOURCE_OF_TRUTH.md#confirmed-operational-rules"
    },
    {
      "id": "failed_strand_test_no_bleach",
      "rule": "When a strand test fails, bleach must not proceed.",
      "aiAuthority": "state_safety_boundary_and_handoff",
      "source": "docs/SOURCE_OF_TRUTH.md#confirmed-operational-rules"
    },
    {
      "id": "live_availability_never_invented",
      "rule": "Live stylist or appointment availability must never be invented.",
      "aiAuthority": "collect_request_and_create_human_task",
      "source": "docs/SOURCE_OF_TRUTH.md#confirmed-operational-rules"
    },
    {
      "id": "waiting_over_ten_minutes",
      "rule": "Hera's stated service-recovery policy is a 10% discount when a client waits more than 10 minutes beyond the agreed appointment time. The AI may explain the policy but cannot claim that a bill was changed without a verified transaction record.",
      "aiAuthority": "explain_only",
      "source": "docs/SOURCE_OF_TRUTH.md#confirmed-operational-rules"
    },
    {
      "id": "standard_service_inclusions",
      "rule": "Hair services include complimentary wash, blow-dry and professional styling unless an approved source states otherwise.",
      "aiAuthority": "explain_only",
      "source": "docs/SOURCE_OF_TRUTH.md#confirmed-operational-rules"
    },
    {
      "id": "service_concern_refinement_window",
      "rule": "A service concern or refinement request should be raised within seven calendar days from completion of the appointment.",
      "aiAuthority": "explain_eligibility_window_and_create_salon_manager_task",
      "source": "docs/HERA_SERVICE_CONSTITUTION.md#6-service-concern-and-refinement-policy"
    },
    {
      "id": "complimentary_refinement_scope",
      "rule": "An eligible client receives a careful management review and a complimentary refinement only when the authorised salon manager confirms that the concern relates to the original service and can be corrected safely. The policy does not automatically guarantee a refund, compensation, a completely different result or an entirely new service.",
      "aiAuthority": "explain_review_process_without_promising_outcome",
      "source": "docs/HERA_SERVICE_CONSTITUTION.md#6-service-concern-and-refinement-policy"
    },
    {
      "id": "refinement_exception_authority",
      "rule": "Within the seven-calendar-day policy, the salon manager may authorise an eligible complimentary refinement. Outside the standard period or in exceptional circumstances, approval is reserved to the managing director or owner.",
      "aiAuthority": "route_to_authorised_role_without_predicting_decision",
      "source": "docs/HERA_SERVICE_CONSTITUTION.md#6-service-concern-and-refinement-policy"
    },
    {
      "id": "timely_booking_authority",
      "rule": "Timely remains the booking source of truth. The AI collects a complete request and creates a receptionist task; a receptionist checks or updates Timely and confirms the verified outcome. The AI must not claim that an appointment was created, changed, cancelled or confirmed until a certified write integration or verified human outcome exists.",
      "aiAuthority": "collect_and_handoff_only",
      "source": "docs/HERA_SERVICE_CONSTITUTION.md#7-booking-authority"
    },
    {
      "id": "financial_authority",
      "rule": "The AI and receptionist have no refund or compensation authority. A salon manager may authorise a policy-based complimentary refinement and the stated 10% waiting-time recovery. Refunds, vouchers, compensation and outside-policy exceptions require the managing director or owner.",
      "aiAuthority": "explain_authority_and_create_human_task",
      "source": "docs/HERA_SERVICE_CONSTITUTION.md#8-financial-authority"
    },
    {
      "id": "photo_video_consent",
      "rule": "Separate explicit consent is required for capturing photos or video and for publishing or using the material externally. Consent proof must be stored in an approved system. Withdrawal blocks future use and creates a privacy-officer review for material already published.",
      "aiAuthority": "explain_and_route_to_privacy_officer_without_claiming_completion",
      "source": "docs/HERA_SERVICE_CONSTITUTION.md#9-photo-and-video-consent"
    }
  ],
