{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/internal/drain",
      "schedule": "* * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/command-centre/reception",
      "destination": "/command-centre/reset",
      "permanent": false
    },
    {
      "source": "/command-centre/reception.html",
      "destination": "/command-centre/reset",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/command-centre",
      "destination": "/command-centre/reset.html"
    },
    {
      "source": "/command-centre/",
      "destination": "/command-centre/reset.html"
    }
  ],
  "headers": [
    {
      "source": "/command-centre/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/command-centre/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/website-concierge-preview/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/api/website-concierge/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/stage3r-calibration-operator",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "functions": {
    "api/whatsapp/*.ts": {
      "maxDuration": "max"
    },
    "api/internal/drain.ts": {
      "maxDuration": "max"
    },
    "api/internal/reset-v3-synthetic-proof.ts": {
      "maxDuration": "max"
    },
    "api/stage3r/worker.ts": {
      "maxDuration": "max",
      "includeFiles": "{evals/*.json,governance/stage3r-*.json}"
    },
    "api/command-centre/receptionist-message.ts": {
      "maxDuration": 60
    },
    "api/command-centre/receptionist-regenerate.ts": {
      "maxDuration": "max"
    },
    "api/command-centre/receptionist-draft.ts": {
      "maxDuration": "max"
    },
    "api/command-centre/reset-retry.ts": {
      "maxDuration": "max"
    },
    "api/command-centre/reset-generate.ts": {
      "maxDuration": "max"
    },
    "api/command-centre/reset-recover.ts": {
      "maxDuration": "max"
    },
    "api/command-centre/reset-message.ts": {
      "maxDuration": 60
    },
    "api/command-centre/reset-state.ts": {
      "maxDuration": 30
    },
    "api/command-centre/**/*.ts": {
      "maxDuration": 30
    },
    "api/website-concierge/message.ts": {
      "maxDuration": "max"
    },
    "api/website-concierge/session.ts": {
      "maxDuration": 30
    },
    "api/website-concierge/health.ts": {
      "maxDuration": 15
    }
  }
}
