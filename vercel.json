{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/whatsapp/webhook.ts": {
      "maxDuration": 300
    },
    "api/internal/drain.ts": {
      "maxDuration": 300
    },
    "api/internal/sync-knowledge.ts": {
      "maxDuration": 300
    },
    "api/website-concierge/session.ts": {
      "maxDuration": 30
    },
    "api/website-concierge/message.ts": {
      "maxDuration": 300
    },
    "api/website-concierge/health.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/internal/drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/sync-knowledge",
      "schedule": "0 3 * * *"
    }
  ]
}
